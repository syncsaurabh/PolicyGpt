# Application Settings
PROJECT_NAME="PolicyGPT API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="change-this-secret-key-in-production-policygpt-group-2"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=15

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/policygpt"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Gmail SMTP Configuration (Optional - falls back to safe logging if not configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_TLS=true


# Twilio SMS Configuration (Optional - falls back to safe logging if not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Firebase Cloud Messaging (Optional)
FIREBASE_CREDENTIALS_PATH=""

# AI Assistant & LLM Configuration (Optional - falls back to built-in grounded engine if not set)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="auto"
LLM_MODEL_NAME="gemini-1.5-flash"

